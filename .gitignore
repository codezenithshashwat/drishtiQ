# Datasets: never committed (see DATA.md). Anchored to the root so src/data/ (code) stays tracked.
/data/

# ==========================================
# MODEL WEIGHTS AND CACHES
# ==========================================

# Model binaries (never push large trained weights)
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors

# Large generated numerical arrays
*.npy
*.npz

# Downloaded pretrained models and caches
/models/pretrained/

# Other model directories: verify their contents before excluding
/models/final/
/models/registry/

# IMPORTANT:
# models/checkpoints/ is intentionally NOT ignored.
# Required JSON metadata should be tracked.
# Model weights inside it are excluded by extensions above.

# Evaluation artefacts: keep the registry and small summaries, drop bulky outputs
results/runs/**/*.png
results/runs/**/predictions_*.csv
results/cache/

