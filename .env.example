# DrishtiQ Network (optional). Copy to .env (git-ignored). Nothing here is required: Saathi works without a key.
# Free-tier Google AI Studio key from a project WITHOUT billing. Backend only; never exposed to the browser.
# GEMINI_API_KEY=
# NETWORK_GEMINI_MODEL=gemini-2.5-flash
# NETWORK_GEMINI_DAILY_CAP=200
# 1 = seed clearly labelled demonstration camps and PROTOTYPE staff accounts. Set 0 for anything real.
NETWORK_DEMO_MODE=1
NETWORK_RETENTION_DAYS=180
